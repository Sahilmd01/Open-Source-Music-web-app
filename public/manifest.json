{
  "name": "Listenify",
  "short_name": "Listenify",
  "description": "Stream music, discover trending playlists, top artists, and new releases with high quality audio.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["music", "entertainment", "audio"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse Music",
      "short_name": "Browse",
      "description": "Explore popular artists, trending songs, and playlists",
      "url": "/",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "New Releases",
      "short_name": "New Releases",
      "description": "Check the latest newly dropped songs and albums",
      "url": "/new",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Songs",
      "short_name": "Songs",
      "description": "Manage and stream your songs library",
      "url": "/songs",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Playlists",
      "short_name": "Playlists",
      "description": "View and manage your playlists",
      "url": "/playlists",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
