NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=5000

# Database Configuration (TiDB Cloud)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=2
DB_NAME=
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslaccept=strict


# STORAGE_ROOT 
MAX_FILE_SIZE_MB=20
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
API_TIMEOUT=30000

# JWT Configuration
JWT_SECRET=
JWT_EXPIRY=
REFRESH_TOKEN_EXPIRY=

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MINUTES=1

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=codewithkinu@gmail.com

# Session Configuration
SESSION_MAX_AGE_DAYS=7
SESSION_SECRET=your_session_secret_key_change_this_in_production_54321

# Google OAuth Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXT_PUBLIC_GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Feature Flags
NEXT_PUBLIC_ENABLE_OTP_LOGIN=true
NEXT_PUBLIC_ENABLE_SOCIAL_AUTH=true

# Environment
NODE_ENV=development
